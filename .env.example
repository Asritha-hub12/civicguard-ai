# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Local MongoDB: mongodb://127.0.0.1:27017/civicguard_db
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/civicguard_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/civicguard_db

# JWT Configuration
# Generate a strong 64-byte random string in production: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here_min_32_characters
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins (comma-separated or single URL)
FRONTEND_URL=http://localhost:3000
